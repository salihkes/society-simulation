SSL_CERT_PATH=config/ssl_cert.pem
SSL_KEY_PATH=config/ssl_key.pem

# ── NPC Chat ────────────────────────────────────────────────────────
# The NPC "brain" (LLM, STT, TTS, RAG) lives in the external Assistant app.
# This server is a thin relay to it over a WebSocket connector; see
# assistant_bridge.py. Nothing about the model, voice, or knowledge is
# configured here anymore.
NPC_CHAT_REQUIRE_AUTH=false

# The Assistant's metaverse WebSocket connector.
ASSISTANT_WS_URL=ws://127.0.0.1:8766
# Per-turn budget in seconds (should exceed the Assistant's own brain timeout).
ASSISTANT_WS_TIMEOUT=130
