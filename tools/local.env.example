# Copy to tools/local.env and edit: the launchers read it before their defaults.
#
# Where server/run.sh keeps its Python venv (and the launchers find it).
# export GAME_DATA="$HOME/.local/share/game"
#
# A folder of offline Python (interpreters/cpython-3.13.*-install_only.tar.gz)
# and wheels (any/, macos-arm64/) for server/run.sh. Unset: python3 and pip.
# export GAME_PACKAGES="/path/to/packages/python"
#
# The public server tools/run/studio.sh falls back to when no local one answers.
# export GAME_PUBLIC_SERVER="wss://example.com/mv"
