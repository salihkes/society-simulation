[rendering]

textures/vram_compression/import_etc2_astc=true
global_illumination/gi/use_half_resolution=true
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels.mobile=8.0
anti_aliasing/quality/msaa_3d.web=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.web=3

[xr]

openxr/enabled=true
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/startup_alert=false
shaders/enabled=true
